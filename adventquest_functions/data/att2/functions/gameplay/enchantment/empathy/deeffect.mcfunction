execute if score @s EMPATHY matches 1..4 at @s anchored eyes positioned ^0.5 ^0.2 ^0.5 run particle dust_color_transition{from_color:[0.9,0.3,0.3],scale:0.05,to_color:[0.98,0.02,0.02]} ~ ~ ~ 0 0 0 1 40

