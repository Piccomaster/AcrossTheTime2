execute if score Selection ASSIST matches 22 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Le niveau des ennemis est échelonné avec votre niveau, cependant leur puissance (indiquée par un symbole au-dessus de leur tête) varie suivant l'endroit et les catégories : sbires, élites ou bosses.","color":"gray","bold":false}]}
