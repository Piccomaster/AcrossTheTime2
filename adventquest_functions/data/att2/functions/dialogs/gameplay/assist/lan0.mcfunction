execute if score Selection ASSIST matches 6 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"À partir du livre <Conscience> vous pouvez jeter vos <Chronotons> au sol pour en donner à vos alliés.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 7 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Si vous ne trouvez pas un marchand ou que vous cherchez l'emplacement d'un <Waypoint>, à partir du livre <Conscience> vous pouvez indiquer leur position.","color":"gray","bold":false}]}
