function att2:dialogs/gameplay/assist/decoration_up

execute if score Selection ASSIST matches 0 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Книга <Сознания> поможет вам в вашем приключении. Она содержит много информации, связанной с вашим прогрессом.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 1 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Просматривайте свои <Достижения> в настройках Minecraft. Количество очков ваших <Подвигов> указано на 5-й странице книги <Сознания>.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 2 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Если вы застряли в прогрессе, воспользуйтесь помощью с основными и побочными квестами из книги <Сознания>.","color":"gray","bold":false}]}
# execute if score Selection ASSIST matches 3 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Если вы потеряли свою <Сферу Дахаля> для произнесения заклинания, вы можете получить её обратно с первой страницы книги <Сознания>.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 4 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Если вы потеряли из виду своих товарищей, из книги <Сознания> с функцией <Сияние> вы можете подсветить их, чтобы лучше их идентифицировать.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 5 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Из книги <Сознания> вы можете сделать свою лошадь неподвижной с помощью функции <Свист>.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 6 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Из книги <Сознания> вы можете бросить свои <Хронотоны> на землю, чтобы передать их союзникам.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 7 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Если вы не можете найти торговца или ищете местоположение <Путевой точки>, из книги <Сознания> вы можете показать их местоположение.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 8 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Вы можете изменить язык во время игры из книги <Сознания>. Доступные языки: <Французский>, <Английский>, <Китайский>, <Японский>, <Корейский>, <Хинди>, <Русский>, <Немецкий>, <Испанский>, <Португальский>.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 9 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Чтобы обновить все статистики вашей книги <Сознания> или магической книги, не забудьте нажать на функцию <Обновить>.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 10 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Если вы потеряли книгу <Сознания>, поговорите с Кельмией в центре Рилиата, чтобы она дала вам другую.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 11 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"<Хронотон> — основная валюта. Вы можете купить все виды предметов за неё у многочисленных торговцев в городах и деревнях.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 12 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Есть особая валюта под названием <Суверенная Чешуя Хаоса>. Она редка и может быть использована для покупки очень мощных <Суверенных> предметов у 2 скрытых торговцев чёрного рынка в Рилиате и Эолорионе.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 13 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Депозитируйте и снимайте свои <Хронотоны> в банках, доступных в каждом городе, чтобы ограничить потери при потере сознания.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 14 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Продавайте ненужные предметы на Чёрном рынке за <Хронотоны>. Чем реже предмет, тем больше вы получите за него.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 15 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Взаимодействуйте с торговцами, чтобы купить все виды предметов (оружие, броню, зелья, заклинания, лошадей, еду...).","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 16 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Кузнецы и алхимики могут продавать все предметы игры, но в зависимости от торговца, они случайным образом предлагают более или менее редкие предметы. Предложения обновляются каждые 30 минут.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 17 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"В лесу Сокаи в доме Чарльза вы можете делать различные ставки на <Хронотоны>, чтобы выиграть множество наград.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 18 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"<Путевые точки> — это ярлыки для быстрого перемещения по миру. Сначала их нужно обнаружить, чтобы использовать.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 19 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Смерть приведёт к потере большего или меньшего количества ваших небанковских <Хронотонов> в зависимости от выбранного уровня сложности, и вы появитесь на позиции последнего проверенного <Контрольного пункта>.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 20 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Есть 4 уровня сложности: <Ученик>, <Ветеран>, <Мастер>, <Кошмар>. Чем выше уровень сложности, тем больше сила врагов и количество очков опыта, а также редкость получаемых предметов.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 21 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Уровень <Кошмар> — высшая сложность игры. Каждая смерть будет стоить вам половины ваших <Хронотонов>, а также полоски опыта. Скорость появления, урон, скорость передвижения и сопротивление врагов drastically увеличены.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 22 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Уровень врагов масштабируется с вашим уровнем, однако их сила (указанная символом над головой) варьируется в зависимости от мест и категорий: миньоны, элиты или боссы.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 24 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Враги измерения <Биллгарт> обычно очень устойчивы к снарядам, а враги измерения <Уранос> обычно очень устойчивы к огню.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 25 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Есть более 500 предметов различной редкости, которые можно получить от врагов и сундуков: <Обычные>, <Квестовые>, <Необычные>, <Редкие>, <Эпические>, <Легендарные>, <Мифические>.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 26 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Есть 5 различных типов оружия с разной скоростью атаки и уроном: <Кинжал>, <Меч>, <Булава>, <Копьё>, <Топор>.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 27 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Есть 6 различных категорий брони и оружия с преимуществами и недостатками в зависимости от материала: <теран>, <грациозный>, <традиционный>, <этернан>, <восхитительный>, <гармоничный>.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 28 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Чем реже предмет, тем он мощнее и тем больше у него чар и бонусов к навыкам.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 29 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Внимательно проверяйте описание предметов, которые вы экипируете, потому что многие из них имеют различные штрафы, которые могут негативно повлиять на ваши навыки.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 30 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Оружие и броня, которые вы находите, будут регулярно ломаться. Следите за прочностью, если цените их атрибуты.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 31 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Золотое оружие и броня самовосстанавливаются при экипировке, но могут быть найдены только в измерении Ангбанд.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 32 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Кольчужная броня даёт дополнительное сердце за каждую экипированную часть.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 33 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Кожаная броня слабее другой брони, но имеет сопротивление отталкиванию и может чаще встречаться во всех измерениях.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 34 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Тупое оружие имеет эффект сопротивления отталкиванию.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 35 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Алмазное оружие и броня сильнее среднего, но не имеют бонусов и встречаются реже.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 36 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Оружие и броня из обсидиана сильнее среднего, имеют дополнительное здоровье и сопротивление отталкиванию, но также встречаются реже.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 37 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Употребление зелий также даёт бонусы и штрафы к навыкам, однако это единственные предметы с ограниченным временем действия эффектов.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 38 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"При удержании копья каждый последующий удар будет давать вам эффект усталости. Этот эффект складывается с штрафом к скорости атаки <HAS>. Чтобы уменьшить его, предпочтительно иногда отдыхать.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 39 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Есть 13 наборов эпической и легендарной брони (вы узнаете их по описанию, написанному светло-зелёным цветом). Если вам удастся экипировать весь набор (шлем, нагрудник, поножи, ботинки), вы получите существенный бонусный эффект к навыкам.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 40 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Набор брони <Отауриан> позволяет дольше дышать и быстрее плавать под водой. Вы можете найти его на острове Асунарк и купить у <Гомера> после открытия подземелья.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 41 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Броня <Пелзион> — единственная неразрушимая броня, не являющаяся мифической.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 42 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Каждое измерение имеет предопределённую таблицу добычи. Некоторые категории предметов доступны только в определённых измерениях.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 43 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"У каждого босса есть своя собственная добыча. Это означает, что с каждой победой определённые очень редкие предметы имеют дополнительный шанс быть полученными в зависимости от побеждённого босса.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 44 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"<Умбра'Тиант> — самый мощный босс. Это единственный, кто предлагает в качестве награды все предметы каждого измерения.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 45 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Большинство боссов можно убивать снова и снова.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 46 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Если все игроки погибнут на арене босса, босс восстановит все свои жизни, и его придётся снова сражаться, чтобы продвинуться.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 47 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Есть способ не сражаться с королём измерения Уранос. Нужно уметь льстить ему..","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 48 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Есть 13 <Мифических> видов оружия, включая щит, а также полный набор брони, зелье и заклинание. Большинство из них доступны только через скрытые и секретные награды за квесты.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 49 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Мифическое оружие — единственное оружие, которое не ломается. Оно также имеет уникальный спецэффект каждый раз, когда вы тратите свои очки <Дахаля>.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 50 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Мифический щит <Слепой бастион> накапливает эффект сопротивления каждый раз, когда вы парируете удар врага.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 51 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Мифический меч <Кровопийца> добавляет эффект восстановления здоровья за каждый удар по врагу.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 52 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Мифический меч <Фенрир> добавляет эффект заморозки, который распространяется на поражённых врагов, предотвращая их движение. При удержании этого оружия вы невосприимчивы к штрафам от холода.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 53 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Мифический меч <Фортуна> создаёт дополнительные сферы опыта за каждый удар по врагу. Это единственное оружие, получаемое в начале игры или из домов героев.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 54 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Мифический меч <Рукирион> добавляет эффект накопления силы за каждый удар по врагу в пределах сокращённого временного интервала, пока не будет достигнут эффект урона по области.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 55 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Мифический меч <Ультима> вызывает серию мощных молний, поражающих врагов с каждым ударом.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 56 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Мифическая булава <Састр> добавляет эффект землетрясения, замедляющий движение и скорость атаки врагов.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 57 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Мифический кинжал <Одинокая Тень> добавляет эффект ослабления, который распространяется на поражённых врагов, нанося урон со временем.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 58 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Мифический топор <Кинуил> добавляет эффект области, который обжигает врагов. При удержании этого оружия вы невосприимчивы к штрафам от жары.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 59 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Мифический лук <Варлорд> вызывает появление молнии там, где падает стрела, нанося урон по области.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 60 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Мифический лук <Инвид Йоэль> добавляет дополнительный эффект урона к выпущенным стрелам. Чем дальше стрелы выпущены, тем больше урона они нанесут.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 61 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Пушка <Интерфейсер> — очень мощное оружие, выпускающее несколько огненных снарядов за выстрел. Однако для её использования требуется ограниченное количество магазинов, которые нужно держать в левой руке.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 62 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Чтобы использовать пушку <Интерфейсер> по желанию, вы должны найти бесконечный магазин. Он расходует только ваши очки Дахаля.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 63 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Есть 3 типа замков и ключей: <Малый>, <Большой> и <Изумрудный>. Чтобы открыть запертую дверь, вы должны держать ключ в руке и нажать ПКМ на замок.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 64 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Есть 28 различных заклинаний <Дахаля>, разделённых на 3 категории: <Разрушение>, <Призыв>, <Изменение>. Большинство из них можно купить у мастера Дахаля.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 65 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Каждое заклинание <Дахаля> имеет 10 уровней силы. Чем чаще вы используете заклинание, тем больше оно будет повышать уровень.","color":"gray","bold":false}]}
