# com
execute if entity @s[nbt={equipment:{head:{components:{"minecraft:custom_data":{EquipmentType:"armor",Rarity:"com"}}}}}] run function att2:gameplay/shop/mending/tools/add_smith_leveling_com
item modify entity @s[nbt={equipment:{head:{components:{"minecraft:custom_data":{EquipmentType:"armor",Rarity:"com",Manufacturer:"teran"}}}}}] armor.head att2:mending/level5/armor/com/teran
item modify entity @s[nbt={equipment:{head:{components:{"minecraft:custom_data":{EquipmentType:"armor",Rarity:"com",Manufacturer:"graceful"}}}}}] armor.head att2:mending/level5/armor/com/graceful
