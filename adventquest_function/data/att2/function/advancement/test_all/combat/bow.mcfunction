# BOW
advancement grant @s[scores={statBOW=1..}] only att2:combat/bow
advancement grant @s[scores={statBOW=10..}] only att2:combat/bow_10
advancement grant @s[scores={statBOW=50..}] only att2:combat/bow_50
advancement grant @s[scores={statBOW=250..}] only att2:combat/bow_250
advancement grant @s[scores={statBOW=1000..}] only att2:combat/bow_1000
advancement grant @s[scores={statBOW=2500..}] only att2:combat/bow_2500