##get score
execute if score @s ElytraRacingSelect matches 1 run return run data modify storage att2:elytra_racing show_bossbar set value {translate:att2.elytra_racing.bossbar.display,color:yellow,with:[{translate:att2.elytra_racing.kert,color:gold},{score:{name:"#minute",objective:"CAL"},color:green},{score:{name:"#second",objective:"CAL"},color:green},{score:{name:"#ms",objective:"CAL"},color:green},{score:{name:"@s",objective:"ElytraRacingMistake"},color:red}]}
