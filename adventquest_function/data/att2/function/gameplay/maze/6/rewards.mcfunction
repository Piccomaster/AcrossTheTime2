#Made by Adventquest												        #
# Process the Maze 6 rewards										        #
# Calculate depending the total score :                                     #
# from att2:gameplay/maze/score/calculate             				        #
# MAX symbol = 39                                                           #
# MAX normal_chest = 80                                                     #
# MAX runic_chest = 46                                                      #
# MAX minions = 126                                                         #
# MAX elites = 1*2min                                                       #
# MAX waypoint = 7                                                          #
# MAX difficulty = 6                                                        #
# MAX time ~= 3600                                                          #
# MAX number = 250                                                          #
# MAX boss = 1                                                              #
# SCORE ~= (39*5 + 80*3 + 46*4 + 126*2 + 25*7 + 7*10)*6 = 6 726             #
# TOTAL SCORE MAX ~= 6 726 + (3600/2) + 250*6*2 ~= 12000                    #
# XP REWARD MAX ~= 12000*5 ~= 60000                                         #
# CHRONOTONS REWARD MAX ~= 12000/5 ~= 2500                                  #
#############################################################################

