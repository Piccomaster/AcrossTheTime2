#layers 1
execute if block ~ ~ ~ snow[layers=1] as @e[tag=CHAIR,type=interaction,tag=New] at @s run tp ~ ~-0.125 ~
#layers 2
execute if block ~ ~ ~ snow[layers=2] as @e[tag=CHAIR,type=interaction,tag=New] at @s run tp ~ ~ ~
#layers 3
execute if block ~ ~ ~ snow[layers=3] as @e[tag=CHAIR,type=interaction,tag=New] at @s run tp ~ ~0.125 ~
#layers 4
execute if block ~ ~ ~ snow[layers=4] as @e[tag=CHAIR,type=interaction,tag=New] at @s run tp ~ ~0.250 ~
#layers 5
execute if block ~ ~ ~ snow[layers=5] as @e[tag=CHAIR,type=interaction,tag=New] at @s run tp ~ ~0.375 ~
#layers 6
execute if block ~ ~ ~ snow[layers=6] as @e[tag=CHAIR,type=interaction,tag=New] at @s run tp ~ ~0.500 ~
#layers 7
execute if block ~ ~ ~ snow[layers=7] as @e[tag=CHAIR,type=interaction,tag=New] at @s run tp ~ ~0.625 ~
#layers 8
execute if block ~ ~ ~ snow[layers=8] as @e[tag=CHAIR,type=interaction,tag=New] at @s run tp ~ ~0.775 ~