function att2:sound/dialogs/simple


#FRENCH LANGUAGE

tellraw @s[scores={LANGUAGE=0}] {text:"-°- La légendaire quête de J'zargo - Partie 3 -°- : ",color:"gray",extra:[{text:"Heureusement que je suis là... Bon, je dois trouver encore un objet convoité par J'zargo dans ces lieux éloignés de Billgart.",color:"aqua","italic":true}]}

#ENGLISH LANGUAGE

tellraw @s[scores={LANGUAGE=1}] {text:"-°- J'zargo's legendary quest - Part 3 -°- : ",color:"gray",extra:[{text:"Luckily I'm here... Well, I have to find one more item J'zargo covets in these far places of Billgart.",color:"aqua","italic":true}]}

#CHINESE LANGUAGE

tellraw @s[scores={LANGUAGE=2}] {text:"-°- J'zargo 的傳奇任務 - 第 3 部分 -°- : ",color:"gray",extra:[{text:"還好我在這， 不然有誰還能幫忙去找遺物呢。這地方離主塔較遠， 不可掉以輕心。",color:"aqua","italic":true}]}

#JAPANESE LANGUAGE

tellraw @s[scores={LANGUAGE=3}] {text:"-°- J'zargoの伝説のクエスト - パート3 -°- : ",color:"gray",extra:[{text:"幸いにも私がここにいます... さて、Billgartから遠く離れたこの場所でJ'zargoが欲しがるアイテムをもう一つ見つけなければなりません。",color:"aqua","italic":true}]}

#KOREAN LANGUAGE

tellraw @s[scores={LANGUAGE=4}] {text:"-°- J'zargo의 전설적인 퀘스트 - 3부 -°- : ",color:"gray",extra:[{text:"다행히 제가 여기 있습니다... 자, Billgart에서 멀리 떨어진 이곳에서 J'zargo가 탐내는 아이템을 하나 더 찾아야 합니다.",color:"aqua","italic":true}]}

#ARABIC LANGUAGE

tellraw @s[scores={LANGUAGE=5}] {text:"-°- المهمة légendaire لـ J'zargo - الجزء 3 -°- : ",color:"gray",extra:[{text:"لحسن الحظ أنا هنا... حسنًا، يجب أن أجد شيئًا آخر يطمح إليه J'zargo في هذه الأماكن البعيدة عن Billgart.",color:"aqua","italic":true}]}

#RUSSIAN LANGUAGE

tellraw @s[scores={LANGUAGE=6}] {text:"-°- Легендарное задание J'zargo - Часть 3 -°- : ",color:"gray",extra:[{text:"К счастью, я здесь... Ладно, мне нужно найти еще один предмет, который J'zargo жаждет, в этих местах, удаленных от Billgart.",color:"aqua","italic":true}]}

#SPANISH LANGUAGE

tellraw @s[scores={LANGUAGE=7}] {text:"-°- La legendaria búsqueda de J'zargo - Parte 3 -°- : ",color:"gray",extra:[{text:"Afortunadamente estoy aquí... Bueno, tengo que encontrar un objeto más que J'zargo desea en estos lugares lejanos de Billgart.",color:"aqua","italic":true}]}

#GERMAN LANGUAGE

tellraw @s[scores={LANGUAGE=8}] {text:"-°- J'zargos legendäre Quest - Teil 3 -°- : ",color:"gray",extra:[{text:"Zum Glück bin ich hier... Nun, ich muss noch einen weiteren Gegenstand finden, den J'zargo in diesen Orten weit von Billgart begehrt.",color:"aqua","italic":true}]}

#HINDI LANGUAGE

tellraw @s[scores={LANGUAGE=9}] {text:"-°- J'zargo की प्रसिद्ध खोज - भाग 3 -°- : ",color:"gray",extra:[{text:"सौभाग्य से मैं यहाँ हूँ... ठीक है, मुझे Billgart से दूर इन स्थानों में J'zargo द्वारा चाही गई एक और वस्तु खोजनी होगी।",color:"aqua","italic":true}]}

#PORTUGUESE LANGUAGE

tellraw @s[scores={LANGUAGE=10}] {text:"-°- A lendária busca de J'zargo - Parte 3 -°- : ",color:"gray",extra:[{text:"Felizmente eu estou aqui... Bem, eu preciso encontrar mais um item que J'zargo cobiça nesses locais distantes de Billgart.",color:"aqua","italic":true}]}

#Simplified Chinese
tellraw @s[scores={LANGUAGE=11}] {text:"-°- J'zargo 的奇妙冒险 - 第 3 部分 -°- : ",color:"gray",extra:[{text:"还好我在这，不然还有谁能帮忙去找遗物呢。这地方离主塔较远，不可掉以轻心。",color:"aqua","italic":true}]}