#sound
playsound minecraft:entity.horse.saddle ambient @s ~ ~ ~ 1 0.5
#title
tellraw @s [{text:" ° ",bold:true,color:"dark_red"},{translate:matching_game.select.title,bold:false,color:"gold"}]
#reset
tellraw @s[scores={MatchingGameId=1..}] [{text:" ° ",bold:true,color:"dark_red"},{translate:matching_game.select.continue,bold:false,color:"yellow",click_event:{action:run_command,command:"/trigger ScoreTrigger set 2844"},hover_event:{action:show_text,value:[{translate:matching_game.select.continue.hover_event}]}}]
#form 1
tellraw @s [{text:" ° ",bold:true,color:"dark_red"},{translate:matching_game.select.4x4,bold:false,color:"#808080"},{translate:att2.chronotons.price,bold:false,color:"yellow",with:[{score:{name:"matching_game_form1",objective:"PRICES"}}],click_event:{action:run_command,command:"/trigger ScoreTrigger set 2845"},hover_event:{action:show_text,value:[{translate:matching_game.select.hover_event},{translate:matching_game.select.4x4}]}}]
#form 2
execute if score Form1_Completed MatchingGame matches 1.. run tellraw @s [{text:" ° ",bold:true,color:"dark_red"},{translate:matching_game.select.4x5,bold:false,color:"#80B380"},{translate:att2.chronotons.price,bold:false,color:"yellow",with:[{score:{name:"matching_game_form2",objective:"PRICES"}}],click_event:{action:run_command,command:"/trigger ScoreTrigger set 2846"},hover_event:{action:show_text,value:[{translate:matching_game.select.hover_event},{translate:matching_game.select.4x5}]}}]
execute unless score Form1_Completed MatchingGame matches 1.. run return run tellraw @s [{text:" ° ",bold:true,color:"dark_red"},{translate:matching_game.select.lock,bold:false,color:"gray",hover_event:{action:show_text,value:[{translate:matching_game.select.lock.hover_event}]}}]
