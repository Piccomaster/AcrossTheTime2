execute if score Selection ASSIST matches 24 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"ビルガート>次元の敵は一般的に投射物に対して非常に抵抗力があり、<ウラノス>次元の敵は一般的に火に対して非常に抵抗力があります。","color":"gray","bold":false}]}
