execute if score Selection ASSIST matches 16 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"鍛冶屋と錬金術師はゲーム内のすべてのアイテムを販売できますが、商人によって、ランダムに珍しいアイテムを提供します。提供品は30分ごとにリセットされます。","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 17 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"ソクァイの森のチャールズの家で、さまざまな賭けを<クロノトン>に対して行い、多くの報酬を獲得できます。","color":"gray","bold":false}]}
