function att2:dialogs/gameplay/assist/decoration_up

execute if score Selection ASSIST matches 0 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"<의식>의 책은 모험 내내 당신을 도울 것입니다. 진행과 관련된 많은 정보가 포함되어 있습니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 1 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Minecraft 옵션에서 <진척도>를 확인할 수 있습니다. <공적> 포인트 수는 <의식> 책의 5페이지에 표시됩니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 2 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"진행이 막힌 것 같다면, <의식> 책에서 메인 퀘스트와 서브 퀘스트에 대한 도움을 받을 수 있습니다.","color":"gray","bold":false}]}
# execute if score Selection ASSIST matches 3 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"주문을 시전하기 위해 <다할 구체>를 잃어버렸다면, <의식> 책의 첫 페이지에서 다시 얻을 수 있습니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 4 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"팀원을 놓쳤다면, <의식> 책의 <빛남> 기능을 사용해 그들을 강조하여 더 쉽게 식별할 수 있습니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 5 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"<의식> 책에서 <휘파람> 기능을 사용해 말을 움직이지 못하게 할 수 있습니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 6 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"<의식> 책에서 <크로노톤>을 땅에 던져 동료들에게 나눠줄 수 있습니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 7 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"상인을 찾을 수 없거나 <웨이포인트>의 위치를 찾고 있다면, <의식> 책에서 그 위치를 표시할 수 있습니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 8 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"게임 중 <의식> 책에서 언어를 변경할 수 있습니다. 가능한 언어는 <프랑스어>, <영어>, <중국어>, <일본어>, <한국어>, <힌디어>, <러시아어>, <독일어>, <스페인어>, <포르투갈어>입니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 9 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"<의식>이나 마법 책의 통계를 업데이트하려면 <업데이트> 기능을 클릭하는 것을 잊지 마세요.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 10 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"<의식> 책을 잃어버렸다면, 리라이아스 중심에 있는 켈미야에게 말해 다른 책을 받으세요.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 11 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"<크로노톤>은 주요 통화입니다. 마을과 도시에 사는 많은 상인들에게서 모든 종류의 아이템을 구매할 수 있습니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 12 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"<혼돈의 주권 비늘>이라는 특별한 통화가 있습니다. 이는 희귀하며, 리라이아스와 엘로리온에 있는 2명의 숨겨진 암시장 상인에게서 매우 강력한 <주권> 아이템을 구매하는 데 사용할 수 있습니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 13 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"각 도시에 있는 은행에서 <크로노톤>을 입출금할 수 있습니다. 기절했을 때 손실을 줄이기 위해 사용하세요.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 14 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"더 이상 필요하지 않은 아이템을 암시장에서 <크로노톤>으로 판매하세요. 아이템이 희귀할수록 더 높은 가격에 팔 수 있습니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 15 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"상인들과 상호작용하여 모든 종류의 아이템(무기, 방어구, 물약, 주문, 말, 음식 등)을 구매할 수 있습니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 16 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"대장장이와 연금술사는 게임의 모든 아이템을 판매할 수 있지만, 상인에 따라 무작위로 더 희귀한 아이템을 제공합니다. 제공품은 30분마다 재설정됩니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 17 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"소콰이 숲의 찰스 집에서 <크로노톤>을 걸고 다양한 내기를 해 많은 보상을 얻을 수 있습니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 18 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"<웨이포인트>는 세계를 빠르게 이동할 수 있는 지름길입니다. 사용하기 전에 먼저 발견해야 합니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 19 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"죽으면 선택한 난이도에 따라 은행에 보관하지 않은 <크로노톤>을 다소 잃게 되며, 마지막으로 확인한 <체크포인트> 위치에 나타납니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 20 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"4가지 난이도가 있습니다: <견습생>, <베테랑>, <마스터>, <악몽>. 난이도가 높을수록 적의 힘이 강해지고, 얻는 경험치와 아이템의 희귀도가 증가합니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 21 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"<악몽> 난이도는 게임의 최고 난이도입니다. 죽을 때마다 <크로노톤>의 절반과 경험치 바를 잃습니다. 적의 생성률, 데미지, 이동 속도 및 저항력이 크게 증가합니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 22 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"적의 레벨은 당신의 레벨에 맞춰 조정되지만, 그들의 힘(머리 위의 기호로 표시)은 장소와 카테고리(하수인, 정예 또는 보스)에 따라 다릅니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 24 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"<빌가르트> 차원의 적은 일반적으로 투사체에 매우 강하고, <우라노스> 차원의 적은 일반적으로 불에 매우 강합니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 25 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"적과 상자에서 얻을 수 있는 500개 이상의 아이템이 있으며, 다양한 희귀도가 있습니다: <일반>, <퀘스트>, <희귀>, <레어>, <에픽>, <전설>, <신화>.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 26 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"공격 속도와 데미지가 다른 5가지 유형의 무기가 있습니다: <단검>, <검>, <둔기>, <창>, <도끼>.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 27 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"6가지 다른 카테고리의 방어구와 무기가 있으며, 재료에 따라 장단점이 있습니다: <테란>, <우아한>, <전통적인>, <이터난>, <매혹적인>, <조화로운>.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 28 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"아이템이 희귀할수록 더 강력하고, 인챈트와 스킬 보너스의 수가 더 많습니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 29 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"장비하는 아이템의 설명을 주의 깊게 확인하세요. 많은 아이템이 스킬에 부정적인 영향을 미치는 다양한 페널티를 가지고 있습니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 30 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"찾은 무기와 방어구는 정기적으로 부서집니다. 속성을 중요시한다면 내구성에 주의하세요.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 31 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"금 무기와 방어구는 장착하면 자동으로 수리되지만, 앙그반드 차원에서만 찾을 수 있습니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 32 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"체인메일 방어구는 장착한 각 부위마다 추가 하트를 제공합니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 33 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"가죽 방어구는 다른 방어구보다 약하지만, 넉백 저항력이 있고 모든 차원에서 더 자주 찾을 수 있습니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 34 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"둔기 무기는 넉백 저항 효과가 있습니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 35 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"다이아몬드 무기와 방어구는 평균보다 강력하지만 보너스가 없고 더 희귀합니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 36 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"흑요석 무기와 방어구는 평균보다 강력하며, 추가 체력과 넉백 저항력이 있지만 더 희귀합니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 37 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"물약을 마시면 스킬 보너스와 페널티도 있지만, 효과 적용 시간이 제한된 유일한 아이템입니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 38 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"창을 들고 있을 때, 연속으로 적중하면 피로 효과가 발생합니다. 이 효과는 <HAS> 공격 속도 감소와 중첩됩니다. 이를 줄이려면 가끔 팔을 쉬는 것이 좋습니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 39 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"13세트의 에픽 및 레전더리 방어구가 있습니다(연두색 설명으로 구분할 수 있습니다). 전체 세트(헬멧, 흉갑, 레깅스, 부츠)를 장착하면 상당한 스킬 보너스 효과를 얻습니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 40 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"<오타우리안> 방어구 세트는 물속에서 더 오래 숨을 쉬고 더 빠르게 헤엄칠 수 있습니다. 아수나크 섬에서 찾거나, 던전을 연 후 <호머>에게서 구입할 수 있습니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 41 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"<펠지온> 방어구는 신화 등급이 아닌 유일한 파괴 불가능한 방어구입니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 42 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"각 차원에는 미리 정의된 전리품 테이블이 있습니다. 일부 카테고리의 아이템은 특정 차원에서만 얻을 수 있습니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 43 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"각 보스는 전용 전리품을 가지고 있습니다. 즉, 각 승리마다 특정 매우 희귀한 아이템을 추가로 얻을 확률이 있습니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 44 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"<움브라티안스>는 가장 강력한 보스입니다. 각 차원의 모든 아이템을 보상으로 제공하는 유일한 보스입니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 45 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"대부분의 보스는 반복해서 죽일 수 있습니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 46 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"보스 아레나에서 모든 플레이어가 죽으면 보스는 체력을 모두 회복하며, 다시 싸워야 진행할 수 있습니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 47 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"우라노스 차원의 왕과 맞서지 않는 방법이 있을 수 있습니다. 그를 아첨하는 방법을 알아야 합니다...","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 48 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"13개의 <신화> 무기가 있으며, 그 중에는 방패와 완전한 방어구 세트, 물약, 주문도 포함됩니다. 대부분은 숨겨진 비밀 퀘스트 보상으로만 얻을 수 있습니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 49 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"신화 무기는 파괴할 수 없는 유일한 무기입니다. 또한 <다할> 포인트를 소비할 때마다 고유한 특수 효과가 있습니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 50 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"신화 방패 <어비글 렘파르>는 적의 공격을 막을 때마다 저항 효과가 누적됩니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 51 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"신화 검 <블트프레서>는 적에게 적중할 때마다 체력 회복 효과를 추가합니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 52 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"신화 검 <펜리르>는 적중한 적에게 퍼지는 빙결 효과를 추가하여 움직이지 못하게 합니다. 이 무기를 들고 있으면 추위 페널티에 면역이 됩니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 53 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"신화 검 <포츈>은 적에게 적중할 때마다 추가 경험치 오브를 생성합니다. 게임 시작 시 얻거나 영웅의 집에서 얻을 수 있는 유일한 무기입니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 54 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"신화 검 <루키리온>은 짧은 시간 간격 내에 적에게 적중할 때마다 파워 스택 효과를 추가하며, 결국 범위 피해 효과가 발동됩니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 55 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"신화 검 <울티마>는 적중할 때마다 강력한 번개를 일으켜 적들을 공격합니다.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 56 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"신화 둔기 <세스트>는 적의 이동 속도와 공격 속도를 늦추는 지진 효과를 추가합니다.","color":"gray","bold":false}]}
