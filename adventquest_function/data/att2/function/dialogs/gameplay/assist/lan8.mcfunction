function att2:dialogs/gameplay/assist/decoration_up

execute if score Selection ASSIST matches 0 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Das Buch des <Bewusstseins> wird dich auf deinem Abenteuer begleiten. Es enthält viele Informationen zu deinem Fortschritt.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 1 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Sieh dir deine <Fortschritte> in den Minecraft-Optionen an. Die Anzahl der Punkte deiner <Heldentaten> ist auf Seite 5 des Buches <Bewusstsein> angegeben.","color":"gray","bold":false}]}
execute if score Selection ASSIST matches 2 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Wenn du in deinem Fortschritt stecken bleibst, finde Hilfe für die Haupt- und Nebenquests im Buch <Bewusstsein>.","color":"gray","bold":false}]}
# execute if score Selection ASSIST matches 3 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Wenn du deine <Dahäl-Sphäre> zum Zauberwirken verlierst, kannst du sie auf der ersten Seite des Buches <Bewusstsein> zurückholen.","color":"gray","bold":false}]}
