execute if score Selection ASSIST matches 17 run tellraw @s {"text":"⊰☼⊱ ","color":"dark_green","bold":true,"extra":[{"text":"Im Soquaï-Wald in Charles' Haus kannst du verschiedene Wetten gegen <Chronotonen> abschließen, um viele Belohnungen zu gewinnen.","color":"gray","bold":false}]}
