function att2:sound/dialogs/simple

# FRENCH
tellraw @s[scores={LANGUAGE=0}] [{text:"Échec du chargement de l'itinéraire, veuillez vous rapprocher des routes principales du continent Sylberland pour sélectionner un nouvel itinéraire",color:"dark_red","bold":true}]

# ENGLISH
tellraw @s[scores={LANGUAGE=1}] [{text:"Route loading failed, please go near the main roads of Sylberland continent to reselect route",color:"dark_red","bold":true}]

# TRADITIONAL CHINESE
tellraw @s[scores={LANGUAGE=2}] [{text:"路線加載失敗，請前往Sylberland大陸的主道路附近重新選取路線",color:"dark_red","bold":true}]

# JAPANESE
tellraw @s[scores={LANGUAGE=3}] [{text:"ルート読み込み失敗、Sylberland大陸の主要道路付近で再選択してください",color:"dark_red","bold":true}]

# KOREAN
tellraw @s[scores={LANGUAGE=4}] [{text:"경로 로딩 실패, Sylberland 대륙의 주요 도로 근처에서 경로를 다시 선택해 주세요",color:"dark_red","bold":true}]

# ARABIC
tellraw @s[scores={LANGUAGE=5}] [{text:"فشل تحميل المسار، يرجى التوجه بالقرب من الطرق الرئيسية في قارة سيلبرلاند لإعادة اختيار المسار",color:"dark_red","bold":true}]

# RUSSIAN
tellraw @s[scores={LANGUAGE=6}] [{text:"Ошибка загрузки маршрута, пожалуйста, подойдите к главным дорогам континента Sylberland, чтобы выбрать новый маршрут",color:"dark_red","bold":true}]

# SPANISH
tellraw @s[scores={LANGUAGE=7}] [{text:"Error al cargar la ruta, por favor acérquese a las carreteras principales del continente Sylberland para volver a seleccionar la ruta",color:"dark_red","bold":true}]

# GERMAN
tellraw @s[scores={LANGUAGE=8}] [{text:"Routenladung fehlgeschlagen, bitte begeben Sie sich in die Nähe der Hauptstraßen des Sylberland-Kontinents, um die Route neu auszuwählen",color:"dark_red","bold":true}]

# HINDI
tellraw @s[scores={LANGUAGE=9}] [{text:"मार्ग लोड करने में विफल, कृपया सिल्बरलैंड महाद्वीप की मुख्य सड़कों के पास जाकर मार्ग का पुनः चयन करें",color:"dark_red","bold":true}]

# PORTUGUESE
tellraw @s[scores={LANGUAGE=10}] [{text:"Falha ao carregar rota, por favor vá até as estradas principais do continente Sylberland para reselecionar a rota",color:"dark_red","bold":true}]

# SIMPLIFIED CHINESE
tellraw @s[scores={LANGUAGE=11}] [{text:"路线加载失败，请前往Sylberland大陆的主道路附近重新选取路线",color:"dark_red","bold":true}]