function att2:sound/dahal/loading_failure

# FRENCH LANGUAGE
tellraw @s[scores={LANGUAGE=0}] {text:"Trop éloigné du point de guidage, retour au point de réapparition annulé",color:"red","bold":false}

# ENGLISH LANGUAGE
tellraw @s[scores={LANGUAGE=1}] {text:"Too far from guidance point, spawn return guidance terminated",color:"red","bold":false}

# TRADITIONAL CHINESE
tellraw @s[scores={LANGUAGE=2}] {text:"距離引導點位過遠，返回重生點引導停止",color:"red","bold":false}

# JAPANESE LANGUAGE
tellraw @s[scores={LANGUAGE=3}] {text:"ガイドポイントから離れすぎています、リスポーン地点への誘導を停止しました",color:"red","bold":false}

# KOREAN LANGUAGE
tellraw @s[scores={LANGUAGE=4}] {text:"안내 지점에서 너무 멀어, 리스폰 지점 복귀 안내 중지",color:"red","bold":false}

# ARABIC LANGUAGE
tellraw @s[scores={LANGUAGE=5}] {text:"بعيد جدًا عن نقطة التوجيه، توقف التوجيه للعودة إلى نقطة البعث",color:"red","bold":false}

# RUSSIAN LANGUAGE
tellraw @s[scores={LANGUAGE=6}] {text:"Слишком далеко от точки наведения, возврат к точке возрождения отменён",color:"red","bold":false}

# SPANISH LANGUAGE
tellraw @s[scores={LANGUAGE=7}] {text:"Demasiado lejos del punto de guía, retorno al punto de reaparición cancelado",color:"red","bold":false}

# GERMAN LANGUAGE
tellraw @s[scores={LANGUAGE=8}] {text:"Zu weit vom Führungspunkt entfernt, Rückkehr zum Spawnpunkt abgebrochen",color:"red","bold":false}

# HINDI LANGUAGE
tellraw @s[scores={LANGUAGE=9}] {text:"मार्गदर्शन बिंदु से बहुत दूर, जन्म स्थान पर वापसी मार्गदर्शन रोका गया",color:"red","bold":false}

# PORTUGUESE LANGUAGE
tellraw @s[scores={LANGUAGE=10}] {text:"Muito longe do ponto de orientação, retorno ao ponto de spawn interrompido",color:"red","bold":false}

# SIMPLIFIED CHINESE
tellraw @s[scores={LANGUAGE=11}] {text:"距离引导点位过远，返回重生点引导停止",color:"red","bold":false}