tellraw @s[scores={LANGUAGE=2}] {text:"附近有敵人，無法傳送",color:"red","bold":false}

# JAPANESE LANGUAGE
tellraw @s[scores={LANGUAGE=3}] {text:"付近に敵がいるため、テレポートできません",color:"red","bold":false}

# KOREAN LANGUAGE
tellraw @s[scores={LANGUAGE=4}] {text:"주변에 적이 있어 텔레포트할 수 없습니다",color:"red","bold":false}

# ARABIC LANGUAGE
tellraw @s[scores={LANGUAGE=5}] {text:"أعداء في الجوار، لا يمكن الإنتقال",color:"red","bold":false}

# RUSSIAN LANGUAGE
tellraw @s[scores={LANGUAGE=6}] {text:"Рядом враги, невозможно телепортироваться",color:"red","bold":false}

# SPANISH LANGUAGE
tellraw @s[scores={LANGUAGE=7}] {text:"Hay enemigos cerca, no se puede teletransportar",color:"red","bold":false}

# GERMAN LANGUAGE
tellraw @s[scores={LANGUAGE=8}] {text:"Feinde in der Nähe, Teleportation nicht möglich",color:"red","bold":false}

# HINDI LANGUAGE
