# PORTUGUESE LANGUAGE
tellraw @s[scores={LANGUAGE=10}] {text:"Inimigos próximos, não é possível teleportar",color:"red","bold":false}

# SIMPLIFIED CHINESE
tellraw @s[scores={LANGUAGE=11}] {text:"附近有敌人，不能进行传送",color:"red","bold":false}