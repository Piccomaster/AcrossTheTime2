function att2:sound/dahal/loading_failure

# FRENCH LANGUAGE
tellraw @s[scores={LANGUAGE=0}] {text:"Des ennemis sont à proximité, téléportation impossible",color:"red","bold":false}

# ENGLISH LANGUAGE
tellraw @s[scores={LANGUAGE=1}] {text:"Enemies nearby, cannot teleport",color:"red","bold":false}

