#sound
playsound noise4 player @s ~ ~ ~ 1 0.5
# FRENCH LANGUAGE
title @s[scores={LANGUAGE=0}] actionbar {text:"Veuillez placer l'objet sur la table d'enchantement avant de continuer",color:"dark_red"}
# ENGLISH LANGUAGE
title @s[scores={LANGUAGE=1}] actionbar {text:"Please place the item on the enchanting table to proceed",color:"dark_red"}
# TRADITIONAL CHINESE
title @s[scores={LANGUAGE=2}] actionbar {text:"請將物品放置到附魔台上再進行操作",color:"dark_red"}
# JAPANESE LANGUAGE
title @s[scores={LANGUAGE=3}] actionbar {text:"操作を行う前にアイテムをエンチャントテーブルに置いてください",color:"dark_red"}
# KOREAN LANGUAGE
title @s[scores={LANGUAGE=4}] actionbar {text:"아이템을 인챈트 테이블에 놓고 작업을 진행하세요",color:"dark_red"}
# ARABIC LANGUAGE
title @s[scores={LANGUAGE=5}] actionbar {text:"يرجى وضع العنصر على طاولة السحر للمتابعة",color:"dark_red"}
# RUSSIAN LANGUAGE
title @s[scores={LANGUAGE=6}] actionbar {text:"Пожалуйста, поместите предмет на стол зачарования для продолжения",color:"dark_red"}
# SPANISH LANGUAGE
title @s[scores={LANGUAGE=7}] actionbar {text:"Coloca el objeto en la mesa de encantamientos para continuar",color:"dark_red"}
# GERMAN LANGUAGE
title @s[scores={LANGUAGE=8}] actionbar {text:"Bitte lege den Gegenstand auf den Verzauberungstisch, um fortzufahren",color:"dark_red"}
# HINDI LANGUAGE
title @s[scores={LANGUAGE=9}] actionbar {text:"आगे बढ़ने के लिए कृपया आइटम को एन्चेंटिंग टेबल पर रखें",color:"dark_red"}
# PORTUGUESE LANGUAGE
title @s[scores={LANGUAGE=10}] actionbar {text:"Por favor, coloque o item na mesa de encantamentos para continuar",color:"dark_red"}
# SIMPLIFIED CHINESE
title @s[scores={LANGUAGE=11}] actionbar {text:"请将物品放置到附魔台上再进行操作",color:"dark_red"}