#sound
playsound noise4 player @s ~ ~ ~ 1 0.8
# FRENCH LANGUAGE
title @s[scores={LANGUAGE=0}] actionbar {"text":"Le niveau d'enchantement a atteint le minimum (ne peut pas être inférieur au niveau initial)","color":"dark_red"}
# ENGLISH LANGUAGE
title @s[scores={LANGUAGE=1}] actionbar {"text":"Enchantment level has reached minimum (cannot be lower than initial level)","color":"dark_red"}
# TRADITIONAL CHINESE
title @s[scores={LANGUAGE=2}] actionbar {"text":"附魔等級已達到最低（不小於初始等級）","color":"dark_red"}
# JAPANESE LANGUAGE
title @s[scores={LANGUAGE=3}] actionbar {"text":"エンチャントレベルが最低値に達しました（初期レベルより下にはできません）","color":"dark_red"}
# KOREAN LANGUAGE
title @s[scores={LANGUAGE=4}] actionbar {"text":"인챈트 레벨이 최소치에 도달했습니다 (초기 레벨보다 낮출 수 없음)","color":"dark_red"}
# ARABIC LANGUAGE
title @s[scores={LANGUAGE=5}] actionbar {"text":"وصل مستوى السحر إلى الحد الأدنى (لا يمكن أن يكون أقل من المستوى الأولي)","color":"dark_red"}
# RUSSIAN LANGUAGE
title @s[scores={LANGUAGE=6}] actionbar {"text":"Уровень зачарования достиг минимума (не может быть ниже начального уровня)","color":"dark_red"}
# SPANISH LANGUAGE
title @s[scores={LANGUAGE=7}] actionbar {"text":"El nivel de encantamiento ha alcanzado el mínimo (no puede ser inferior al nivel inicial)","color":"dark_red"}
# GERMAN LANGUAGE
title @s[scores={LANGUAGE=8}] actionbar {"text":"Die Verzauberungsstufe hat das Minimum erreicht (kann nicht niedriger als die Ausgangsstufe sein)","color":"dark_red"}
# HINDI LANGUAGE
title @s[scores={LANGUAGE=9}] actionbar {"text":"मोहन स्तर न्यूनतम पर पहुँच गया है (प्रारंभिक स्तर से कम नहीं हो सकता)","color":"dark_red"}
# PORTUGUESE LANGUAGE
title @s[scores={LANGUAGE=10}] actionbar {"text":"O nível de encantamento atingiu o mínimo (não pode ser inferior ao nível inicial)","color":"dark_red"}
# SIMPLIFIED CHINESE
title @s[scores={LANGUAGE=11}] actionbar {"text":"附魔等级已达到最低（不小于初始等级）","color":"dark_red"}