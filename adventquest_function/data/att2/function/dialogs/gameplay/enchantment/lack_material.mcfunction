#sound
stopsound @a[distance=..10] * block.amethyst_cluster.break
playsound noise4 player @s ~ ~ ~ 1 1
# FRENCH LANGUAGE
title @s[scores={LANGUAGE=0}] actionbar {"text":"Matériaux d'enchantement manquants","color":"dark_red"}
# ENGLISH LANGUAGE
title @s[scores={LANGUAGE=1}] actionbar {"text":"Missing enchantment materials","color":"dark_red"}
# TRADITIONAL CHINESE
title @s[scores={LANGUAGE=2}] actionbar {"text":"缺少附魔所需材料","color":"dark_red"}
# JAPANESE LANGUAGE
title @s[scores={LANGUAGE=3}] actionbar {"text":"エンチャントに必要な材料が不足しています","color":"dark_red"}
