#sound
playsound noise4 player @s ~ ~ ~ 1 1
# FRENCH LANGUAGE
title @s[scores={LANGUAGE=0}] actionbar {text:"Le niveau d'enchantement maximum est atteint, impossible d'améliorer",color:"dark_red"}
# ENGLISH LANGUAGE
title @s[scores={LANGUAGE=1}] actionbar {text:"Enchantment level has reached maximum, cannot upgrade",color:"dark_red"}
# TRADITIONAL CHINESE
title @s[scores={LANGUAGE=2}] actionbar {text:"已達到附魔等級上限，無法進行升級",color:"dark_red"}
# JAPANESE LANGUAGE
title @s[scores={LANGUAGE=3}] actionbar {text:"エンチャントレベルが上限に達しました、これ以上アップグレードできません",color:"dark_red"}
# KOREAN LANGUAGE
title @s[scores={LANGUAGE=4}] actionbar {text:"인챈트 레벨이 최대에 도달하여 업그레이드할 수 없습니다",color:"dark_red"}
# ARABIC LANGUAGE
title @s[scores={LANGUAGE=5}] actionbar {text:"وصل مستوى السحر إلى الحد الأقصى، لا يمكن الترقية",color:"dark_red"}
